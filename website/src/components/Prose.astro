---
interface Props {
  text: string;
}
const { text } = Astro.props;
// Isolate explicit Latin input syntax in RTL prose; content remains plain text.
const pattern = /(root\(index, radicand\)|var\(name\)|@name|\.cwiznb|v\d+\.\d+\.\d+|\bAns\b)/g;
const parts = text.split(pattern);
---

{parts.map((part, index) => (index % 2 ? <bdi dir="ltr">{part}</bdi> : part))}
