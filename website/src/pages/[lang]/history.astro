---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SourceLinks from '../../components/SourceLinks.astro';
import Prose from '../../components/Prose.astro';
import { content, type Locale } from '../../data/site';
import { editorial } from '../../data/editorial';
import history from '../../data/history.json';
export function getStaticPaths() {
  return ['en', 'ar'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = editorial[lang];
---

<Base lang={lang} title={`${t.history} — REZANOVA`} description={t.historyIntro} page="history">
  <div class="details-mast">
    <Header lang={lang} page="history" />
  </div>
  <main id="main" class="details-page history-page wrap">
    <a class="back-link" href={`/${lang}/`}>
      {content[lang].back}
    </a>
    <p class="eyebrow">REZANOVA · {t.history}</p>
    <h1>{t.historyTitle}</h1>
    <p class="section-intro">{t.historyIntro}</p>
    <p class="reading-note">{t.historyNote}</p>
    <nav class="chapter-nav" aria-label={t.historyNav}>
      <a href="#v030" dir="ltr">
        v0.3.0
      </a>
      <a href="#graphing-browser">{lang === 'en' ? 'Graphs & browser' : 'الرسم والمتصفح'}</a>
      <a href="#notebook-results">{lang === 'en' ? 'Notebook' : 'الدفتر'}</a>
      <a href="#v020" dir="ltr">
        v0.2.0
      </a>
      <a href="#beginnings">{lang === 'en' ? 'The beginnings' : 'البدايات'}</a>
    </nav>
    <ol class="timeline">
      {history.map((entry) => {
        const e = entry[lang];
        return (
          <li
            class:list={['timeline-entry', { 'version-entry': entry.kind === 'version' }]}
            id={entry.id}
          >
            <article aria-labelledby={`title-${entry.id}`}>
              <div class="timeline-meta">
                <span class="entry-kind">{entry.kind === 'version' ? t.version : t.milestone}</span>
                <span>{e.date}</span>
              </div>
              <h2 id={`title-${entry.id}`}>
                <Prose text={e.title} />
              </h2>
              <p class="entry-summary">
                <Prose text={e.summary} />
              </p>
              <ul class="change-list">
                {e.bullets.map((bullet) => (
                  <li>
                    <Prose text={bullet} />
                  </li>
                ))}
              </ul>
              <SourceLinks lang={lang} sources={entry.sources} />
            </article>
          </li>
        );
      })}
    </ol>
    <section class="development-note">
      <h2>{t.further}</h2>
      <p>{content[lang].roadmapBody}</p>
      <a class="text-link" href={`/${lang}/capabilities/`}>
        {t.readCapabilities} <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
