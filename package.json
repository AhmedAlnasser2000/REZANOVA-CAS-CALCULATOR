{
  "name": "calcwiz-desktop",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "build:analyze": "npm run build && node tools/report-bundle-size.mjs --write-report",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:memory-protocol": "node --test tools/validate-memory-protocol.test.mjs && node tools/validate-memory-protocol.mjs",
    "test:ci-gate-alignment": "node --test tools/validate-ci-gate-alignment.test.mjs && node tools/validate-ci-gate-alignment.mjs",
    "test:seam-impact-selector": "node --test tools/seam-impact-selector.test.mjs",
    "test:feature-probes": "vitest run src/lib/anti-regression/feature-probe-registry.test.ts src/lib/engine/math-engine/numeric-evaluation.test.ts src/lib/equation/equation-complex.test.ts src/lib/modes/equation/answer-modes.test.ts src/lib/modes/equation/complex-domain.test.ts src/lib/display/notation/math-notation.test.ts src/lib/display/notation/symbolic-display.test.ts src/lib/display/notation/numeric-output.test.ts src/lib/app-state/settings.test.ts && vitest run --config vitest.ui.config.ts src/components/SettingsPanel.ui.test.tsx src/app/shell/SettingsPage.ui.test.tsx src/app/shell/ActiveSurfaceHost.ui.test.tsx src/app/shell/ModeStrip.ui.test.tsx src/app/runtime/useHistoryDisplayRuntime.ui.test.tsx src/app/runtime/useAppPersistenceRuntime.ui.test.tsx",
    "test:pillars": "node --test tools/validate-pillars.test.mjs && node tools/validate-pillars.mjs",
    "test:golden": "vitest run src/lib/__golden__/golden-runner.test.ts",
    "test:print-hygiene": "vitest run src/lib/display/print-hygiene.test.ts",
    "test:printer-contract": "vitest run src/lib/display/printer/*.test.ts src/lib/equation/presentation/printer-adapter.test.ts",
    "test:printer-migration": "node --test tools/printer-migration-ratchet.test.mjs && node tools/printer-migration-ratchet.mjs",
    "report:printer-migration": "node tools/printer-migration-ratchet.mjs",
    "update:printer-migration": "node tools/printer-migration-ratchet.mjs --write-baseline",
    "test:detail-segment-migration": "node --test tools/detail-segment-migration-ratchet.test.mjs && node tools/detail-segment-migration-ratchet.mjs",
    "test:result-intent": "node --test tools/result-intent-ratchet.test.mjs && node tools/result-intent-ratchet.mjs && vitest run src/lib/display/result/result-intent-coverage.test.ts",
    "test:result-contract": "vitest run src/lib/result-contract/*.test.ts",
    "test:mathjson-coverage": "vitest run src/lib/result-contract/mathjson-coverage.test.ts",
    "report:mathjson-coverage": "vite-node tools/mathjson-coverage-ratchet.ts",
    "update:mathjson-coverage": "vite-node tools/mathjson-coverage-ratchet.ts --write-baseline",
    "test:equation-solve-result": "vitest run src/lib/equation/solve-result/*.test.ts",
    "test:display-contract-inversion": "node --test tools/display-contract-inversion-ratchet.test.mjs && node tools/display-contract-inversion-ratchet.mjs",
    "report:display-contract-inversion": "node tools/display-contract-inversion-ratchet.mjs",
    "update:display-contract-inversion": "node tools/display-contract-inversion-ratchet.mjs --write-baseline",
    "report:detail-segment-migration": "node tools/detail-segment-migration-ratchet.mjs",
    "update:detail-segment-migration": "node tools/detail-segment-migration-ratchet.mjs --write-baseline",
    "test:clipboard-contract": "vitest run src/lib/clipboard/envelope.test.ts src/lib/clipboard/tauri-adapter.test.ts src/lib/clipboard/capabilities.test.ts src/app/logic/displayClipboard.test.ts src/app/logic/clipboardPipeline.test.ts src/app/logic/expressionRouting.test.ts && vitest run --config vitest.ui.config.ts src/lib/clipboard/browser-adapter.ui.test.ts src/components/MathEditor.ui.test.tsx src/app/shell/ActiveSurfaceHost.ui.test.tsx && node --test tools/clipboard-capability-audit.test.mjs && node tools/clipboard-capability-audit.mjs",
    "test:clipboard-capability": "playwright test e2e/clipboard-capability-audit.spec.ts --project=chromium",
    "test:clipboard-tauri": "cargo test --manifest-path src-tauri/Cargo.toml --test clipboard_linux -- --nocapture",
    "update:print-hygiene": "vite-node tools/update-print-hygiene.ts",
    "test:workspace-freshness": "node --test tools/workspace-freshness.test.mjs",
    "report:workspace-freshness": "node tools/workspace-freshness.mjs",
    "update:history-replay-fixtures": "vite-node tools/update-history-replay-fixtures.ts",
    "test:history-replay": "vitest run src/lib/history-replay/*.test.ts && node --test tools/import-history-replay.test.mjs",
    "test:history-replay:browser": "playwright test e2e/history-replay-ratchet.spec.ts --project=chromium",
    "report:history-replay": "vite-node tools/report-history-replay.ts",
    "import:history-replay": "node tools/import-history-replay.mjs",
    "generate:labs-catalog": "node tools/generate-labs-catalog.mjs",
    "test:labs-catalog": "node --test tools/validate-labs-catalog.test.mjs && node tools/validate-labs-catalog.mjs",
    "test:source-mirrors": "node --test tools/validate-source-mirrors.test.mjs && node tools/validate-source-mirrors.mjs",
    "test:area-studies": "node --test tools/validate-area-studies.test.mjs && node tools/validate-area-studies.mjs",
    "test:calculus-limits-corpus": "node --test tools/validate-calculus-limits-corpus-ledger.test.mjs && node tools/validate-calculus-limits-corpus-ledger.mjs && vitest run src/lib/calculus/limit-ledger-corpus.test.ts",
    "test:calculus-integration-corpus": "node --test tools/validate-calculus-integration-corpus-ledger.test.mjs && node tools/validate-calculus-integration-corpus-ledger.mjs",
    "test:surface-protocol": "node --test tools/validate-surface-protocol-boundaries.test.mjs && node tools/validate-surface-protocol-boundaries.mjs && vitest run src/lib/surface-protocol/*.test.ts",
    "test:ooe-boundaries": "node --test tools/validate-ooe-boundaries.test.mjs && node tools/validate-ooe-boundaries.mjs",
    "test:compartments-boundaries": "node --test tools/validate-compartment-boundaries.test.mjs && node tools/validate-compartment-boundaries.mjs",
    "report:compartments": "node tools/report-compartment-contracts.mjs",
    "test:file-sizes": "node --test tools/validate-file-sizes.test.mjs && node tools/validate-file-sizes.mjs",
    "test:canary-registry": "vitest run --config vitest.canary.config.ts",
    "test:canaries:browser": "playwright test e2e/canaries/workspace-canaries.spec.ts --project=chromium",
    "test:canaries": "npm run build && npm run test:canaries:browser",
    "test:runtime-probes": "vitest run src/lib/modes/runtime-probes/*.test.ts src/lib/modes/statistics-worker-runtime.test.ts src/lib/modes/table-worker-runtime.test.ts",
    "test:workspace-runtime-contracts": "vitest run src/lib/modes/calculate-worker-runtime.test.ts src/lib/modes/equation-worker-runtime.test.ts src/lib/modes/calculus-worker-client.test.ts src/lib/modes/trigonometry-worker-runtime.test.ts src/lib/modes/geometry-worker-runtime.test.ts src/lib/modes/linear-algebra-worker-runtime.test.ts src/lib/modes/statistics-worker-runtime.test.ts src/lib/modes/table-worker-runtime.test.ts src/lib/modes/table.test.ts src/lib/modes/runtime-probes/registry.test.ts src/lib/ooe/runtime-control/runtime-shell-contract.test.ts src/lib/ooe/job-launch/job-contract.test.ts",
    "test:app-runtime-contracts": "vitest run src/app/logic && vitest run --config vitest.ui.config.ts src/app/runtime",
    "test:display-contracts": "vitest run src/lib/display && vitest run --config vitest.ui.config.ts src/app/shell/DisplayPanel.ui.test.tsx src/app/shell/DisplayOutcomeShell.ui.test.tsx src/app/shell/FormulaViewerPage.ui.test.tsx src/app/shell/display-panel/DetailLineContent.ui.test.tsx src/app/shell/display-panel/DisplayDetailContract.ui.test.tsx",
    "test:app-state-contracts": "vitest run src/lib/app-state src/types/calculator/runtime-contracts.test.ts",
    "test:launch-preflight": "node --test tools/check-tauri-linux-deps.test.mjs tools/fix-linux-watch-limits.test.mjs",
    "test:app-identity": "node --test tools/check-app-identity.test.mjs",
    "test:bundle-size": "node tools/report-bundle-size.mjs --check",
    "test:unit": "vitest run --maxWorkers=4",
    "test:playground": "vitest run --config vitest.playground.config.ts",
    "playground:ssh-vm": "vite-node playground/level-0-research/external-compute/operator-entrypoint.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts --maxWorkers=4",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "npm run build && playwright test",
    "test:gate": "npm run test:memory-protocol && npm run test:ci-gate-alignment && npm run test:seam-impact-selector && npm run test:printer-migration && npm run test:detail-segment-migration && npm run test:result-intent && npm run test:result-contract && npm run test:mathjson-coverage && npm run test:equation-solve-result && npm run test:display-contract-inversion && npm run test:clipboard-contract && npm run test:feature-probes && npm run test:app-identity && npm run test:surface-protocol && npm run test:pillars && npm run test:golden && npm run test:print-hygiene && npm run test:workspace-freshness && npm run test:labs-catalog && npm run test:source-mirrors && npm run test:area-studies && npm run test:ooe-boundaries && npm run test:compartments-boundaries && npm run test:file-sizes && npm run test:canary-registry && npm run test:runtime-probes && npm run test:unit && npm run test:ui && npm run test:e2e && npm run lint && cargo check --manifest-path src-tauri/Cargo.toml",
    "seam:impact": "node tools/seam-impact-selector.mjs",
    "test:unit:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "pretauri:dev": "node tools/check-tauri-linux-deps.mjs",
    "tauri:dev": "npx tauri dev --no-watch",
    "fix:linux-watch-limits": "node tools/fix-linux-watch-limits.mjs",
    "pretauri:dev:watch": "node tools/check-tauri-linux-deps.mjs",
    "tauri:dev:watch": "npx tauri dev",
    "pretauri:build": "node tools/check-tauri-linux-deps.mjs",
    "tauri:build": "npx tauri build"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.54.1",
    "@fontsource/fira-sans-condensed": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tiptap/core": "3.27.3",
    "@tiptap/extension-color": "3.27.3",
    "@tiptap/extension-highlight": "3.27.3",
    "@tiptap/extension-text-style": "3.27.3",
    "@tiptap/react": "3.27.3",
    "@tiptap/starter-kit": "3.27.3",
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001775",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.23.0",
    "mathlive": "^0.108.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.0.18"
  }
